# Resend (https://resend.com) – required for the contact form to send email
RESEND_API_KEY=re_xxxxx

# Where contact form submissions are sent (advisor/rep inbox)
CONTACT_EMAIL_TO=advisors@tradefrontsouth.com

# Optional: "From" address (must be a verified domain in Resend, or use onboarding@resend.dev for testing)
# CONTACT_EMAIL_FROM=onboarding@resend.dev
